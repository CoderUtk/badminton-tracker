{
  "expo": {
    "name": "CourtSide",
    "slug": "badminton-tracker",
    "owner": "coderutk",
    "version": "1.6.1",
    "orientation": "portrait",
    "scheme": "badminton",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0E12",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.navalo.courtside",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "instagram-stories",
          "instagram"
        ]
      }
    },
    "android": {
      "package": "com.navalo.courtside",
      "googleServicesFile": "./google-services.json",
      "versionCode": 26,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundImage": "./assets/adaptive-background.png",
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#0C0E12"
      },
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "courtside-links.vercel.app",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0C0E12"
        }
      ],
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "./plugins/withQuietAndroidBuild",
      "./plugins/withReleaseSigning",
      "./plugins/withWindowsCmakeShortPath",
      [
        "@sentry/react-native/expo",
        {
          "organization": "navalo-eg",
          "project": "badminton-tracker"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8ecffb0-5af5-4ac7-b8a0-dde5bdb42989"
      }
    }
  }
}
