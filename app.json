{
  "expo": {
    "name": "CourtSide",
    "slug": "badminton-tracker",
    "owner": "coderutk",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "badminton",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0E12",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.navalo.courtside"
    },
    "android": {
      "package": "com.navalo.courtside",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundImage": "./assets/adaptive-background.png",
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#0C0E12"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0C0E12"
        }
      ],
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8ecffb0-5af5-4ac7-b8a0-dde5bdb42989"
      }
    }
  }
}
