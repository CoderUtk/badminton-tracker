npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (never commit real secrets; keep .env.example tracked)
.env
.env.local
.env*.local
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# testing
coverage/

# agent & editor tooling artifacts
.claude/bt-claude-backup/
.claude/settings.local.json
.codex/
.tokensave/
.idea/
.vscode/

# generated knowledge graph (regenerate with: graphify update .)
graphify-out/
