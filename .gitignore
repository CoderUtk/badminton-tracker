# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/

# store-assets scratch (raw device captures + composited html embed account email)
store-assets/raw/
store-assets/composite/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (never commit real secrets; keep .env.example tracked)
.env
.env.local
.env*.local
!.env.example

# Google Play service account key (secret — never commit)
google-service-account*.json
*service-account*.json
play-store-*.json

# Google OAuth client secrets (secret — never commit)
client_secret*.json
*.apps.googleusercontent.com.json

# Supabase CLI local state
supabase/.temp/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# testing
coverage/

# agent & editor tooling artifacts
.claude/bt-claude-backup/
.claude/settings.local.json
.codex/
.tokensave/
.idea/
.vscode/
.agents/
.kiro/
.claude/
.ruflo/
skills-lock.json
skills/

# generated knowledge graph (regenerate with: graphify update .)
graphify-out/

# Superpowers SDD. Ledgers, briefs, and task reports are tracked so progress
# is visible across machines and people. Review diffs are not: they snapshot
# commit ranges that already exist in git history, and regenerate on every run.
.superpowers/**/*.diff

# Agent tooling scaffolding (local only)
.agent/

# Signing material. The upload keystore reaches CI through the
# UPLOAD_KEYSTORE_BASE64 repo secret — it must never be committed again.
keystore.txt
*.keystore
*.jks

# EAS's local-credentials override (credentialsSource: "local"). References
# the same upload keystore by absolute path plus its passwords in plaintext.
credentials.json

# Firebase service-account keys for FCM V1. These are real credentials and
# reach EAS through `eas credentials`, never through git. The download is named
# <project>-firebase-adminsdk-<hash>.json, which the google-service-account*
# pattern above does not catch.
*firebase-adminsdk*.json

# Personal scratch notes (kept locally, not project docs)
bugs.txt
features.txt
ui_changes.txt
.worktrees/
.vercel
.env*
