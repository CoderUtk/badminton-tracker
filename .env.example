# Copy to .env and fill in from your Supabase project (Settings → API).
# Without these the app runs in offline-only mode (scoring + local history).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Sentry crash reporting (Settings → Client Keys (DSN) on a React
# Native Sentry project). Without this, crash reporting is simply off.
EXPO_PUBLIC_SENTRY_DSN=

# Optional: only needed to upload source maps for readable stack traces in
# the Sentry dashboard (org/project already set in app.json). Create at
# Sentry → Settings → Auth Tokens, scope: project:releases. Without this,
# crash reporting still works, traces are just minified. NEVER commit the
# real value — this is a secret.
SENTRY_AUTH_TOKEN=

# Optional: domain hosting join-link fallback pages (Vercel project
# "courtside-links"). Without this, shared links use the badminton:// custom
# scheme, which does not render as a tappable link in chat apps. See
# docs/superpowers/specs/2026-08-05-share-links-design.md.
EXPO_PUBLIC_JOIN_LINK_DOMAIN=courtside-links.vercel.app
