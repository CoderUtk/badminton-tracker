# Copy to .env and fill in from your Supabase project (Settings → API).
# Without these the app runs in offline-only mode (scoring + local history).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Sentry crash reporting (Settings → Client Keys (DSN) on a React
# Native Sentry project). Without this, crash reporting is simply off.
EXPO_PUBLIC_SENTRY_DSN=
