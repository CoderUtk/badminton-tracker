{
  "rewrites": [
    { "source": "/join/(.*)", "destination": "/join/index.html" },
    { "source": "/.well-known/assetlinks.json", "destination": "/assetlinks.json" }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
